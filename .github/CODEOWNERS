# Path -> crate ownership.
#
# Combined with .github/labeler.yml this keeps review scoped: a pull request
# touching only the renderer does not need sign-off from whoever owns the rules.
#
# GitHub silently drops a rule whose owner it cannot resolve, so every handle
# here must be a real account with write access to this repository. Add teams
# in place of the handle once the repository lives under an organisation.

*                       @pixbs

# The simulation and its data are the highest-risk surface: a change here can
# silently alter every saved game.
/crates/lands-core/       @pixbs
/crates/lands-rules/      @pixbs
/assets/rules/          @pixbs
/spec/                  @pixbs
/tests/replays/         @pixbs

# The gates themselves. Changing these changes what CI is willing to accept.
/xtask/                 @pixbs
/.github/               @pixbs
/.githooks/             @pixbs
/deny.toml              @pixbs
/AGENTS.md              @pixbs
