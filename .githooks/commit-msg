#!/bin/sh
# Reject commit messages that credit an AI assistant, and enforce Conventional
# Commits.
#
# Install once:  git config core.hooksPath .githooks
#
# This is the first of three lines of defence. CI re-checks the whole commit
# range (`cargo xtask check-commits`) so `--no-verify` cannot get past it, and
# branch protection requires that job.

set -e

msg_file="$1"
msg=$(cat "$msg_file")

# Strip comment lines so the commit template cannot trip the checks.
body=$(printf '%s\n' "$msg" | grep -v '^#' || true)
lower=$(printf '%s' "$body" | tr '[:upper:]' '[:lower:]')

banned="claude codex kiwi anthropic copilot chatgpt openai"
for word in $banned; do
    if printf '%s' "$lower" | grep -q "$word"; then
        echo "commit-msg: rejected — the message mentions '$word'." >&2
        echo "Commit messages and authorship must not name an AI assistant." >&2
        echo "See CONTRIBUTING.md." >&2
        exit 1
    fi
done

for phrase in "co-authored-by: ai" "generated with" "ai-generated"; do
    if printf '%s' "$lower" | grep -q "$phrase"; then
        echo "commit-msg: rejected — the message contains '$phrase'." >&2
        exit 1
    fi
done

# Conventional Commits: type(scope): summary
subject=$(printf '%s\n' "$body" | grep -v '^[[:space:]]*$' | head -n 1)

# Merge and revert commits are generated by git; leave them alone.
case "$subject" in
    Merge*|Revert*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
    echo "commit-msg: rejected — subject is not a Conventional Commit." >&2
    echo "" >&2
    echo "  got:      $subject" >&2
    echo "  expected: type(scope): summary" >&2
    echo "" >&2
    echo "  type:  feat fix docs style refactor perf test build ci chore revert" >&2
    echo "  scope: the crate, e.g. core, render, worldgen, levels" >&2
    echo "" >&2
    echo "  example: feat(core): territory split conserves the treasury (#42)" >&2
    exit 1
fi

if [ "${#subject}" -gt 100 ]; then
    echo "commit-msg: rejected — subject is ${#subject} characters, limit is 100." >&2
    exit 1
fi

exit 0
